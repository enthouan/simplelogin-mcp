---
import DefaultBanner from '@astrojs/starlight/components/Banner.astro';

const authorUrl = 'https://www.antoinemenard.com';
const disclaimer =
  'It is not an official SimpleLogin project and is not affiliated with, endorsed by, or supported by SimpleLogin or Proton.';
---

<DefaultBanner />
<aside
  class="affiliation-notice"
  aria-label="Project attribution and relationship"
  data-pagefind-ignore
>
  <strong>Independent project.</strong>
  <span>
    simplelogin-mcp is an open-source project developed by <a
      href={authorUrl}
      rel="author external"
      referrerpolicy="no-referrer">Antoine Ménard</a
    >. {disclaimer}
  </span>
</aside>

<style>
  @layer starlight.core {
    .affiliation-notice {
      padding: 0.7rem clamp(1rem, 3vw, 2.5rem);
      border-bottom: 1px solid var(--sl-color-hairline);
      color: var(--sl-color-gray-1);
      background: var(--sl-color-accent-low);
      font-size: var(--sl-text-sm);
      line-height: 1.5;
      text-align: center;
      text-wrap: balance;
    }

    .affiliation-notice strong {
      color: var(--sl-color-accent-high);
    }

    .affiliation-notice a {
      color: var(--sl-color-accent-high);
      font-weight: 650;
      text-decoration-thickness: 0.08em;
      text-underline-offset: 0.16em;
    }
  }
</style>
