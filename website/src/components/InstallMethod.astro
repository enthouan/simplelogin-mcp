---
import CopyableCode from './CopyableCode.astro';
import { getInstallMethod, type InstallMethodKey } from '../data/install.js';

interface Props {
  method: InstallMethodKey;
  showGuideLink?: boolean;
}

const { method: methodKey, showGuideLink = false } = Astro.props;
const method = getInstallMethod(methodKey);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const guideHref = `${base}${method.href.replace(/^\//, '')}`;
---

<div class="install-method" data-install-method={method.key}>
  <CopyableCode code={method.code} label={method.title} language={method.language} />
  {
    method.key === 'docker' && (
      <p>
        Compose listens on <code>0.0.0.0:3000</code> inside the container, publishes only to{' '}
        <code>127.0.0.1</code> by default, and still requires <code>MCP_AUTH_TOKEN</code>.
      </p>
    )
  }
  {
    method.key === 'http' && (
      <p>
        Connect to <code>POST http://127.0.0.1:3000/mcp</code>. A direct loopback run does not
        require <code>MCP_AUTH_TOKEN</code>; every wider bind does and belongs behind TLS.
      </p>
    )
  }
  {
    method.key === 'stdio' && (
      <p>
        Run <code>pnpm install --frozen-lockfile &amp;&amp; pnpm build</code> first. Stdio does not
        use <code>MCP_AUTH_TOKEN</code>; keep the client config private because it contains your API
        key.
      </p>
    )
  }
  {showGuideLink && <a href={guideHref}>Read the complete {method.label} guide →</a>}
</div>
