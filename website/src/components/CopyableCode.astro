---
interface Props {
  code: string;
  label: string;
  language: string;
}

const { code, label, language } = Astro.props;
---

<copyable-snippet class="copyable-code not-content">
  <div class="copyable-code__bar">
    <span>{language}</span>
    <button type="button" aria-label={`Copy ${label}`} hidden>
      <span aria-hidden="true">⧉</span>
      <span data-copy-label>Copy</span>
    </button>
  </div>
  <pre tabindex="0" aria-label={label}><code>{code}</code></pre>
  <p data-copy-help hidden>
    Copy failed. Select the code and copy it manually; no content was changed.
  </p>
  <span class="visually-hidden" data-copy-status role="status" aria-live="polite" aria-atomic="true"
  ></span>
</copyable-snippet>

<script>
  class CopyableSnippet extends HTMLElement {
    #resetTimer: number | undefined;
    #busy = false;

    connectedCallback() {
      const button = this.querySelector('button');
      button?.removeAttribute('hidden');
      button?.addEventListener('click', () => void this.copy());
    }

    async copy() {
      if (this.#busy) return;

      const button = this.querySelector('button');
      const code = this.querySelector('code');
      const label = this.querySelector<HTMLElement>('[data-copy-label]');
      const help = this.querySelector<HTMLElement>('[data-copy-help]');
      const status = this.querySelector<HTMLElement>('[data-copy-status]');
      if (!button || !code || !label || !help || !status) return;

      this.#busy = true;
      window.clearTimeout(this.#resetTimer);
      button.setAttribute('aria-busy', 'true');
      button.setAttribute('aria-disabled', 'true');
      label.textContent = 'Copying…';
      help.hidden = true;
      status.textContent = '';

      try {
        await navigator.clipboard.writeText(code.textContent ?? '');
        label.textContent = 'Copied';
        status.textContent = `${code.parentElement?.getAttribute('aria-label') ?? 'Code'} copied.`;
        this.#resetTimer = window.setTimeout(() => {
          label.textContent = 'Copy';
          status.textContent = '';
        }, 2000);
      } catch {
        label.textContent = 'Copy failed';
        help.hidden = false;
        status.textContent = 'Copy failed. Select the code and copy it manually.';
      } finally {
        this.#busy = false;
        button.removeAttribute('aria-busy');
        button.removeAttribute('aria-disabled');
      }
    }
  }

  if (!customElements.get('copyable-snippet')) {
    customElements.define('copyable-snippet', CopyableSnippet);
  }
</script>
