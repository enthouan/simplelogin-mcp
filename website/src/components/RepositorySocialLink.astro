---
import { Icon } from '@astrojs/starlight/components';
import config from 'virtual:starlight/user-config';
import {
  REPOSITORY_URL,
  formatRepositoryStarCount,
  formatRepositoryStarCountLabel,
  getRepositoryStarCount,
} from '../data/repository.js';

const links = config.social || [];
const starCount = await getRepositoryStarCount();
const starCountText = formatRepositoryStarCount(starCount);
const starCountLabel = formatRepositoryStarCountLabel(starCount);
---

{
  links.map(({ label, href, icon }) => {
    const isRepository = href === REPOSITORY_URL;
    const visibleStarCount = isRepository ? starCountText : undefined;
    const accessibleLabel = isRepository && starCountLabel ? `${label}, ${starCountLabel}` : label;

    return (
      <a
        href={href}
        rel={isRepository ? 'me external' : 'me'}
        referrerpolicy={isRepository ? 'no-referrer' : undefined}
        class="sl-flex"
        aria-label={accessibleLabel}
        data-repository-navigation={isRepository || undefined}
      >
        <Icon name={icon} />
        {visibleStarCount && (
          <span class="star-count" aria-hidden="true">
            <Icon name="star" />
            <span>{visibleStarCount}</span>
          </span>
        )}
      </a>
    );
  })
}

<style>
  @layer starlight.core {
    a {
      align-items: center;
      gap: 0.4rem;
      margin: -0.5em;
      padding: 0.5em;
      color: var(--sl-color-text-accent);
      text-decoration: none;
      white-space: nowrap;
    }

    a:hover {
      color: var(--sl-color-white);
    }

    .star-count {
      display: inline-flex;
      gap: 0.2rem;
      align-items: center;
      font-size: var(--sl-text-sm);
      font-weight: 600;
      line-height: 1;
    }
  }
</style>
