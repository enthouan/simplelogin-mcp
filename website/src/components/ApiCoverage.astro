---
import { compiledContent } from '../../../docs/api-coverage.md';
import { REPOSITORY_URL } from '../data/repository.js';

const repositorySourceLink = /<a href="\.\.\/([^"#?]+)">(.*?)<\/a>/g;
const canonicalHeading = /^<h1\b[^>]*>.*?<\/h1>\s*/;

const sourceHtml = (await compiledContent())
  .replace(canonicalHeading, '')
  .replace(repositorySourceLink, (_match, sourcePath, label) => {
    const sourceName = sourcePath.split('/').at(-1);
    const repositoryView = sourceName?.includes('.') ? 'blob' : 'tree';
    return `<a href="${REPOSITORY_URL}/${repositoryView}/main/${sourcePath}" rel="external">${label}</a>`;
  })
  .replaceAll('<table>', '<div class="api-coverage-table" tabindex="0"><table>')
  .replaceAll('</table>', '</table></div>');
---

<div class="api-coverage" set:html={sourceHtml} />

<style>
  .api-coverage :global(.api-coverage-table) {
    margin-block: 1.5rem;
    overflow-x: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    scrollbar-gutter: stable;
  }

  .api-coverage :global(.api-coverage-table:focus-visible) {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .api-coverage :global(.api-coverage-table table) {
    min-width: 68rem;
    margin: 0;
    border: 0;
  }

  .api-coverage :global(.api-coverage-table th:first-child) {
    min-width: 17rem;
  }

  .api-coverage :global(.api-coverage-table th:last-child) {
    min-width: 22rem;
  }
</style>
