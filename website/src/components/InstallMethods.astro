---
import { TabItem, Tabs } from '@astrojs/starlight/components';
import InstallMethod from './InstallMethod.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const guideRoot = `${base}getting-started/`;
---

<div class="install-methods" data-install-methods>
  <Tabs syncKey="install-method">
    <TabItem label="Docker Compose">
      <InstallMethod method="docker" showGuideLink />
    </TabItem>
    <TabItem label="Direct Node.js">
      <InstallMethod method="http" showGuideLink />
    </TabItem>
    <TabItem label="Local stdio">
      <InstallMethod method="stdio" showGuideLink />
    </TabItem>
  </Tabs>
  <noscript>
    <style>
      [data-install-methods] starlight-tabs {
        display: none !important;
      }
    </style>
    <nav aria-label="Installation guides without JavaScript">
      JavaScript is disabled. Open the <a href={`${guideRoot}docker/`}>Docker Compose</a>,{' '}
      <a href={`${guideRoot}http/`}>Direct Node.js</a>, or{' '}
      <a href={`${guideRoot}stdio/`}>Local stdio</a> guide to read every setup method.
    </nav>
  </noscript>
</div>
