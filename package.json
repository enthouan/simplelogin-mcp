{
  "name": "simplelogin-mcp",
  "version": "0.1.0",
  "description": "Self-hostable Model Context Protocol (MCP) server for the SimpleLogin API.",
  "license": "MIT",
  "author": "Antoine Ménard",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "simplelogin-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "simplelogin",
    "email-alias",
    "privacy",
    "self-hosted"
  ],
  "packageManager": "pnpm@11.5.1",
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.12.23",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
