{
  "name": "simplelogin-mcp",
  "version": "0.8.1",
  "description": "Self-hostable Model Context Protocol (MCP) server for the SimpleLogin API.",
  "license": "MIT",
  "author": "Antoine Ménard",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "bin": {
    "simplelogin-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "TOOL_CATALOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "website:dev": "pnpm --dir website dev",
    "website:build": "pnpm --dir website build",
    "website:preview": "pnpm --dir website preview",
    "website:typecheck": "pnpm --dir website typecheck",
    "website:check": "pnpm website:typecheck && pnpm website:build && vitest run test/website.test.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "smoke:live": "tsc -p tsconfig.build.json && tsx src/smoke/live.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "simplelogin",
    "email-alias",
    "privacy",
    "self-hosted"
  ],
  "packageManager": "pnpm@11.5.1",
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.12.34",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
