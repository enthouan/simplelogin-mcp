# Docker Compose reads this file for interpolation and passes only the variables
# explicitly mapped in the Compose file into the container.
#
# Direct-run application controls. The bundled Compose files keep the container
# on HTTP at 0.0.0.0:3000 and ignore these three values.
# Transport mode: "http" (default; for self-hosting) or "stdio" (local desktop clients).
TRANSPORT=http

# Network interface the HTTP server binds to. Ignored when TRANSPORT=stdio.
# Default 127.0.0.1 = reachable only from this machine (safe by default).
# Set 0.0.0.0 to expose it on your LAN / the internet, but then you MUST also set
# MCP_AUTH_TOKEN (the server refuses to start otherwise). See SECURITY.md.
HOST=127.0.0.1

# Port the HTTP server listens on. Ignored when TRANSPORT=stdio.
PORT=3000

# Optional Docker Compose controls. These affect Compose image selection and
# host-side publishing only; the bundled Compose files keep the container's
# internal HTTP listener on port 3000.
SIMPLELOGIN_MCP_IMAGE_TAG=latest
SIMPLELOGIN_MCP_HOST_BIND_IP=127.0.0.1
SIMPLELOGIN_MCP_HOST_PORT=3000

# SimpleLogin API base URL. Override this to point at a self-hosted SimpleLogin instance.
SL_API_URL=https://app.simplelogin.io

# Optional path, inside the Node process or container, to an additional PEM CA file.
# Compose users must also mount the file at this container path. Leave empty when
# SimpleLogin uses a certificate trusted by Node's standard CA bundle.
NODE_EXTRA_CA_CERTS=

# Your SimpleLogin API key (REQUIRED). Create one at SimpleLogin -> Settings -> API Keys.
# Sent as the `Authentication` header on every API request. This key grants full control
# of your aliases and mailboxes. Treat it like a password. See SECURITY.md.
SL_API_KEY=

# Authenticates clients TO THIS SERVER. If set, POST /mcp requires
# `Authorization: Bearer <token>`. Required whenever HOST is non-loopback; the
# bundled Docker Compose files set HOST=0.0.0.0 inside the container, so set this
# before `docker compose up`. Generate a strong value, e.g. `openssl rand -hex 32`.
# Leave empty only for loopback-only, non-container use.
MCP_AUTH_TOKEN=

# Optional. Comma-separated extra browser origins allowed to call POST /mcp. Loopback
# origins (localhost / 127.0.0.1, any port) are always allowed; non-browser MCP clients
# send no Origin and are unaffected. Set this only if a browser client on a non-loopback
# origin must reach the server, e.g. MCP_ALLOWED_ORIGINS=https://mcp.example.com
MCP_ALLOWED_ORIGINS=

# Escape hatch: allow a non-loopback bind WITHOUT MCP_AUTH_TOKEN. Only set true when
# exposure is already contained elsewhere (an authenticating reverse proxy, a firewall,
# or another deployment layer). Leaving it false is the safe default.
ALLOW_UNAUTHENTICATED_EXPOSURE=false

# Per-request timeout to the SimpleLogin API, in milliseconds.
SL_REQUEST_TIMEOUT_MS=15000

# Optional live smoke-test controls. Live smoke tests are manual only; they are
# never run by `pnpm test` or CI.
# SL_API_KEY is required for stdio smoke. HTTP-only smoke can omit it when the
# target HTTP server is already running with its own SimpleLogin API key.
# SMOKE_TRANSPORT=stdio        # stdio, http, or all
# SMOKE_HTTP_URL=http://127.0.0.1:3000/mcp
# SMOKE_CONTACT=create         # create or skip
# SMOKE_STEP_TIMEOUT_MS=60000
# SMOKE_MAX_LOOKUP_PAGES=5
# SMOKE_STDIO_SERVER=dist/index.js
