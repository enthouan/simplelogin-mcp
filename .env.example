# Transport mode: http for hosted Streamable HTTP, stdio for local MCP clients.
TRANSPORT=http

# HTTP port used when TRANSPORT=http.
PORT=3000

# Optional bearer token required on POST /mcp when set.
MCP_AUTH_TOKEN=

# SimpleLogin API base URL. Override for self-hosted SimpleLogin.
SL_API_URL=https://app.simplelogin.io

# Required SimpleLogin API key from the SimpleLogin dashboard.
SL_API_KEY=
